---
// Card.astro
// Resumen de una especie: la recibe por props, no busca datos por su cuenta.
import Etiqueta from "../ui/Etiqueta.astro";

const { especie } = Astro.props;
const { id, nombre, cientifico, reino, familia, region, estado } = especie;
const base = import.meta.env.BASE_URL;
---

<article
  class="tarjeta"
  data-nombre={`${nombre} ${cientifico}`.toLowerCase()}
  data-reino={reino}
  data-familia={familia}
>
  <div class="tarjeta__medio">
    <div class="tarjeta__placeholder" aria-hidden="true">
      <span class="tarjeta__inicial">{nombre.slice(0, 1)}</span>
      <span class="tarjeta__cientifico-badge">{cientifico}</span>
    </div>

    <span class="tarjeta__estado">{estado}</span>

    <button
      class="tarjeta__favorito"
      type="button"
      aria-label={`Guardar ${nombre} en favoritos`}
      aria-pressed="false"
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l7.8-7.8a5.5 5.5 0 0 0 0-7.8Z" />
      </svg>
    </button>
  </div>

  <div class="tarjeta__cuerpo">
    <h3 class="tarjeta__titulo">
      <a class="tarjeta__enlace" href={`${base}catalogo#${id}`}>
        {nombre}
      </a>
    </h3>
    <p class="tarjeta__meta"><em>{cientifico}</em> · {region}</p>
    <div class="tarjeta__etiquetas">
      <Etiqueta>{reino}</Etiqueta>
      <Etiqueta variante="neutro">{familia}</Etiqueta>
    </div>
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-fondo);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m);
    overflow: hidden;
    box-shadow: var(--sombra-s);
    transition: box-shadow var(--transicion), transform var(--transicion);
  }

  .tarjeta:hover {
    box-shadow: var(--sombra-m);
    transform: translateY(-2px);
  }

  .tarjeta__medio {
    position: relative;
  }

  .tarjeta__placeholder {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--esp-1);
    background: linear-gradient(135deg, var(--color-marca-suave), var(--color-superficie));
    color: var(--color-marca);
    padding: var(--esp-3);
    text-align: center;
  }

  .tarjeta__inicial {
    font-family: var(--fuente);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .tarjeta__cientifico-badge {
    font-size: var(--texto-xs);
    font-style: italic;
    color: var(--color-texto-tenue);
  }

  .tarjeta__estado {
    position: absolute;
    left: var(--esp-2);
    bottom: var(--esp-2);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radio-pill);
    background: rgba(27, 42, 34, 0.82);
    color: #ffffff;
    font-size: var(--texto-xs);
    font-weight: 700;
  }

  .tarjeta__favorito {
    position: absolute;
    top: var(--esp-2);
    right: var(--esp-2);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-pill);
    background: var(--color-fondo);
    color: var(--color-texto);
    cursor: pointer;
  }

  .tarjeta__favorito:hover {
    color: var(--color-marca);
  }

  .tarjeta__cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
    padding: var(--esp-3);
  }

  .tarjeta__titulo {
    font-size: var(--texto-m);
    margin: 0;
  }

  .tarjeta__enlace {
    color: var(--color-texto);
    text-decoration: none;
  }

  .tarjeta__enlace::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .tarjeta__enlace:focus-visible {
    outline: none;
  }

  .tarjeta:has(.tarjeta__enlace:focus-visible) {
    outline: 3px solid var(--color-marca);
    outline-offset: 2px;
  }

  .tarjeta__meta {
    margin: 0;
    font-size: var(--texto-s);
    color: var(--color-texto-tenue);
  }

  .tarjeta__etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-1);
  }
</style>