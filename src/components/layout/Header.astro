---
const { activo = "inicio" } = Astro.props;
const base = import.meta.env.BASE_URL;

const enlaces = [
  { clave: "inicio", nombre: "Inicio", ruta: "" },
  { clave: "catalogo", nombre: "Catálogo", ruta: "catalogo" },
  { clave: "favoritos", nombre: "Favoritos", ruta: "favoritos" },
  { clave: "contacto", nombre: "Contacto", ruta: "contacto" },
  { clave: "acerca-de", nombre: "Acerca de", ruta: "acerca-de" },
];
---

<header class="encabezado">
  <div class="contenedor encabezado__interior">
    <a class="marca" href={base}>
      <span class="marca__nombre">RutaViva</span>
      <span class="marca__sub">Biodiversidad de Colombia</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul class="nav__lista">
        {enlaces.map((e) => (
          <li>
            <a
              class:list={["nav__enlace", { "nav__enlace--activo": activo === e.clave }]}
              href={`${base}${e.ruta}`}
              aria-current={activo === e.clave ? "page" : undefined}
            >
              {e.nombre}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .encabezado {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-fondo);
    border-bottom: 1px solid var(--color-borde);
  }

  .encabezado__interior {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
    padding-top: var(--esp-3);
    padding-bottom: var(--esp-3);
  }

  @media (min-width: 860px) {
    .encabezado__interior {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .marca {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-texto);
  }

  .marca__nombre {
    font-family: var(--fuente);
    font-size: var(--texto-l);
    font-weight: 700;
    color: var(--color-marca);
    line-height: 1.1;
  }

  .marca__sub {
    font-size: var(--texto-xs);
    color: var(--color-texto-tenue);
  }

  .nav__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__enlace {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--esp-3);
    border-radius: var(--radio-pill);
    text-decoration: none;
    font-size: var(--texto-s);
    font-weight: 600;
    color: var(--color-texto);
    transition: background var(--transicion), color var(--transicion);
  }

  .nav__enlace:hover {
    background: var(--color-superficie);
    color: var(--color-marca);
  }

  .nav__enlace--activo,
  .nav__enlace[aria-current="page"] {
    background: var(--color-marca-suave);
    color: var(--color-marca);
  }
</style>