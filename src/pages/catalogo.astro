---
import Layout from "../layouts/Layout.astro";
import Card from "../components/catalogo/Card.astro";
import { obtenerEspecies, obtenerFiltros } from "../services/api.js";

const especies = await obtenerEspecies();
const { reinos, familias } = obtenerFiltros(especies);
---

<Layout
  titulo="Catálogo de especies — RutaViva"
  descripcion="Filtra y explora las especies registradas en RutaViva."
  activo="catalogo"
>
  <section class="contenedor">
    <p class="rotulo">Catálogo</p>
    <h1>Catálogo de especies</h1>
    <p class="subtitulo">
      Filtra por reino o familia, o busca una especie por nombre común o científico.
    </p>

    <div class="controles">
      <div class="busqueda">
        <svg
          class="busqueda__icono"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        <label class="solo-lectores" for="campo-busqueda">Buscar especie</label>
        <input
          id="campo-busqueda"
          class="busqueda__campo"
          type="search"
          placeholder="Buscar por nombre común o científico..."
        />
      </div>

      <div class="filtros">
        <div class="filtro">
          <label class="filtro__etiqueta" for="filtro-reino">Reino</label>
          <select id="filtro-reino" class="filtro__select">
            <option value="">Todos los reinos</option>
            {reinos.map((r) => <option value={r}>{r}</option>)}
          </select>
        </div>

        <div class="filtro">
          <label class="filtro__etiqueta" for="filtro-familia">Familia</label>
          <select id="filtro-familia" class="filtro__select">
            <option value="">Todas las familias</option>
            {familias.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>
      </div>
    </div>

    <p id="contador" class="contador">Mostrando {especies.length} especies</p>

    <div id="rejilla-especies" class="rejilla">
      {especies.map((especie) => <Card especie={especie} />)}
    </div>

    <div id="estado-vacio" class="caja-vacia" hidden>
      <h2>No encontramos especies</h2>
      <p>Prueba con otro nombre o limpia los filtros para ver todo el catálogo.</p>
    </div>
  </section>
</Layout>

<script>
  const input = document.getElementById("campo-busqueda");
  const selectReino = document.getElementById("filtro-reino");
  const selectFamilia = document.getElementById("filtro-familia");
  const tarjetas = Array.from(document.querySelectorAll("#rejilla-especies .tarjeta"));
  const contador = document.getElementById("contador");
  const vacio = document.getElementById("estado-vacio");

  function filtrar() {
    const texto = (input?.value || "").trim().toLowerCase();
    const reino = selectReino?.value || "";
    const familia = selectFamilia?.value || "";

    let visibles = 0;

    tarjetas.forEach((tarjeta) => {
      const nombre = tarjeta.getAttribute("data-nombre") || "";
      const tReino = tarjeta.getAttribute("data-reino") || "";
      const tFamilia = tarjeta.getAttribute("data-familia") || "";

      const coincideTexto = !texto || nombre.includes(texto);
      const coincideReino = !reino || tReino === reino;
      const coincideFamilia = !familia || tFamilia === familia;

      const mostrar = coincideTexto && coincideReino && coincideFamilia;
      tarjeta.hidden = !mostrar;
      if (mostrar) visibles++;
    });

    if (contador) {
      contador.textContent =
        visibles === 1 ? "Mostrando 1 especie" : `Mostrando ${visibles} especies`;
    }
    if (vacio) {
      vacio.hidden = visibles > 0;
    }
  }

  input?.addEventListener("input", filtrar);
  selectReino?.addEventListener("change", filtrar);
  selectFamilia?.addEventListener("change", filtrar);
</script>

<style>
  .subtitulo {
    max-width: var(--ancho-lectura);
    color: var(--color-texto-tenue);
  }

  .controles {
    display: grid;
    gap: var(--esp-3);
    margin: var(--esp-4) 0;
    padding: var(--esp-4);
    background: var(--color-fondo);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m);
  }

  @media (min-width: 860px) {
    .controles {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
  }

  .busqueda {
    position: relative;
  }

  .busqueda__icono {
    position: absolute;
    left: var(--esp-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-texto-tenue);
    pointer-events: none;
  }

  .busqueda__campo {
    width: 100%;
    min-height: 48px;
    padding: 0 var(--esp-3) 0 calc(var(--esp-3) + 28px);
    font: inherit;
    color: var(--color-texto);
    background: var(--color-fondo);
    border: 1px solid var(--color-borde-fuerte);
    border-radius: var(--radio-s);
  }

  .busqueda__campo::placeholder {
    color: var(--color-texto-tenue);
  }

  .filtros {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--esp-2);
  }

  .filtro {
    display: flex;
    flex-direction: column;
    gap: var(--esp-1);
  }

  .filtro__etiqueta {
    font-size: var(--texto-xs);
    font-weight: 700;
    color: var(--color-texto-tenue);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .filtro__select {
    min-height: 48px;
    padding: 0 var(--esp-3);
    font: inherit;
    font-size: var(--texto-s);
    color: var(--color-texto);
    background: var(--color-fondo);
    border: 1px solid var(--color-borde-fuerte);
    border-radius: var(--radio-s);
  }

  .contador {
    font-size: var(--texto-s);
    color: var(--color-texto-tenue);
    margin: 0 0 var(--esp-3);
  }

  .rejilla {
    display: grid;
    gap: var(--esp-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .rejilla {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .rejilla {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .caja-vacia {
    margin-top: var(--esp-4);
    border: 1px dashed var(--color-borde-fuerte);
    border-radius: var(--radio-m);
    padding: var(--esp-6);
    text-align: center;
    color: var(--color-texto-tenue);
    background: var(--color-fondo);
  }

  .caja-vacia p {
    margin: 0;
  }
</style>