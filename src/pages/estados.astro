---
import Layout from "../layouts/Layout.astro";
import CardGrid from "../components/catalogo/CardGrid.astro";
import Esqueleto from "../components/ui/Esqueleto.astro";
import Estado from "../components/ui/Estado.astro";
import Paginacion from "../components/catalogo/Paginacion.astro";
import { especies } from "../data/datos-de-prueba.js";

const base = import.meta.env.BASE_URL;
---

<Layout
  titulo="Estados de pantalla — RutaViva"
  descripcion="Referencia visual de los cuatro estados: cargando, con datos, vacío y error."
  activo="catalogo"
>
  <div class="contenedor">
    <p class="rotulo">Referencia UI</p>
    <h1>Los cuatro estados del catálogo</h1>
    <p class="intro">
      Cada pantalla con datos debe contemplar siempre sus cuatro estados: cargando,
      con datos, vacío y error.
    </p>

    <section class="bloque">
      <p class="rotulo">Estado 1</p>
      <h2>Cargando (Esqueleto)</h2>
      <Esqueleto cantidad={3} />
    </section>

    <section class="bloque">
      <p class="rotulo">Estado 2</p>
      <h2>Con datos</h2>
      <CardGrid especies={especies.slice(0, 3)} />
      <Paginacion paginaActual={1} totalPaginas={3} />
    </section>

    <section class="bloque">
      <p class="rotulo">Estado 3</p>
      <h2>Vacío (sin resultados)</h2>
      <Estado
        tipo="vacio"
        titulo="No encontramos especies"
        mensaje="Ninguna especie coincide con la búsqueda actual. Prueba con otro nombre o quita los filtros."
        textoAccion="Ver todo el catálogo"
        hrefAccion={`${base}catalogo`}
      />
    </section>

    <section class="bloque">
      <p class="rotulo">Estado 4</p>
      <h2>Error</h2>
      <Estado
        tipo="error"
        titulo="No pudimos cargar el catálogo"
        mensaje="Ocurrió un problema al consultar los datos de biodiversidad. Inténtalo de nuevo en unos segundos."
        textoAccion="Reintentar"
        hrefAccion={`${base}estados`}
      />
    </section>
  </div>
</Layout>

<style>
  .intro {
    max-width: var(--ancho-lectura);
    color: var(--color-texto-tenue);
  }

  .bloque {
    margin-top: var(--esp-6);
  }
</style>