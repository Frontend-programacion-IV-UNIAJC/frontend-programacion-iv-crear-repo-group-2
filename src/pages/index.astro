---
import Layout from "../layouts/Layout.astro";
import Boton from "../components/ui/Boton.astro";
import Card from "../components/catalogo/Card.astro";
import { especies } from "../data/datos-de-prueba.js";

const base = import.meta.env.BASE_URL;
const destacadas = especies.slice(0, 3);
---

<Layout
  titulo="RutaViva — Biodiversidad de Colombia"
  descripcion="Explora las especies que hacen de Colombia un territorio megadiverso."
  activo="inicio"
  ancho="ancho"
>
  <section class="portada">
    <div class="contenedor portada__interior">
      <div class="portada__texto">
        <p class="rotulo">Biodiversidad de Colombia</p>
        <h1>Explora la biodiversidad</h1>
        <p class="portada__entrada">
          Descubre las especies que hacen de Colombia un territorio megadiverso:
          consulta fichas taxonómicas, reinos, familias y distribución en un solo lugar.
        </p>

        <div class="portada__acciones">
          <Boton href={`${base}catalogo`} tamano="grande">Explorar catálogo</Boton>
          <Boton href={`${base}acerca-de`} variante="secundario" tamano="grande">
            Acerca del proyecto
          </Boton>
        </div>

        <ul class="portada__datos">
          <li><strong>{especies.length}</strong> especies iniciales</li>
          <li><strong>2</strong> filtros taxonómicos</li>
          <li><strong>100%</strong> en español</li>
        </ul>
      </div>

      <div class="portada__tarjeta">
        <p class="rotulo">Un vistazo a nuestra diversidad</p>
        <p class="portada__resumen">
          Oso de anteojos, Jaguar, Gallito de las rocas andino, Frailejón y muchas
          más especies emblemáticas del país.
        </p>
      </div>
    </div>
  </section>

  <section class="contenedor seccion">
    <div class="seccion__cabecera">
      <div>
        <p class="rotulo">Para empezar</p>
        <h2>Especies destacadas</h2>
      </div>
      <Boton href={`${base}catalogo`} variante="secundario">Ver todas</Boton>
    </div>

    <div class="rejilla">
      {destacadas.map((especie) => <Card especie={especie} />)}
    </div>
  </section>

  <section class="contenedor seccion">
    <p class="rotulo">Cómo funciona</p>
    <h2>Tres pasos para explorar RutaViva</h2>

    <div class="pasos">
      <article class="paso">
        <span class="paso__num">1</span>
        <h3>Busca una especie</h3>
        <p>Encuentra fauna y flora por nombre común, científico, reino o familia.</p>
      </article>

      <article class="paso">
        <span class="paso__num">2</span>
        <h3>Consulta su ficha</h3>
        <p>Revisa su clasificación taxonómica, distribución y estado de conservación.</p>
      </article>

      <article class="paso">
        <span class="paso__num">3</span>
        <h3>Guarda tus favoritas</h3>
        <p>Marca las especies que más te interesen para volver a consultarlas rápido.</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .portada {
    background: var(--color-marca-suave);
    border-bottom: 1px solid var(--color-borde);
    padding: var(--esp-6) 0;
  }
  .portada__interior {
    display: grid;
    gap: var(--esp-5);
    align-items: center;
  }
  @media (min-width: 900px) {
    .portada__interior {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
  .portada__entrada {
    max-width: var(--ancho-lectura);
    color: var(--color-texto-tenue);
  }
  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
    margin: var(--esp-4) 0;
  }
  .portada__datos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--texto-s);
    color: var(--color-texto-tenue);
  }
  .portada__tarjeta {
    background: var(--color-fondo);
    border: 1px solid var(--color-marca-borde);
    border-radius: var(--radio-m);
    padding: var(--esp-5);
    box-shadow: var(--sombra-s);
  }
  .portada__resumen {
    margin: 0;
    color: var(--color-texto-tenue);
  }
  .seccion {
    margin-top: var(--esp-6);
  }
  .seccion__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--esp-3);
    margin-bottom: var(--esp-4);
  }
  .rejilla {
    display: grid;
    gap: var(--esp-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .rejilla {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .rejilla {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pasos {
    display: grid;
    gap: var(--esp-4);
  }
  @media (min-width: 768px) {
    .pasos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .paso {
    background: var(--color-fondo);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-m);
    padding: var(--esp-4);
  }
  .paso__num {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radio-s);
    background: var(--color-marca-suave);
    color: var(--color-marca);
    font-weight: 700;
    margin-bottom: var(--esp-2);
  }
  .paso p {
    margin: 0;
    font-size: var(--texto-s);
    color: var(--color-texto-tenue);
  }
</style>